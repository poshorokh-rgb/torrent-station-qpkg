#!/bin/sh
# Auto-generated by TorrentStation.sh from on-torrent-added.sh.template
# on every start — do not edit this file directly, edit the .template.
#
# Invoked by transmission-daemon itself (script-torrent-added-filename)
# whenever a torrent is added, regardless of whether any browser tab is
# open. Env vars provided by the daemon: TR_TORRENT_NAME, TR_TORRENT_HASH.

HISTORY_FILE="__HISTORY_FILE__"
WEB_HISTORY_FILE="/opt/share/transmission/public_html/history.jsonl"

esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n'; }

NAME="$(esc "$TR_TORRENT_NAME")"
HASH="$(esc "$TR_TORRENT_HASH")"
TS="$(date +%s)"

LINE="{\"ts\":${TS},\"event\":\"added\",\"name\":\"${NAME}\",\"hash\":\"${HASH}\"}"

printf '%s\n' "$LINE" >> "$HISTORY_FILE" 2>/dev/null
printf '%s\n' "$LINE" >> "$WEB_HISTORY_FILE" 2>/dev/null
